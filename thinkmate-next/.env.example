# Environment Variables for ThinkMate Next.js App
# Copy this file to .env.local for local development
# For production, set these in Railway dashboard

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Resend Email Service (for contact form)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here
CONTACT_EMAIL=your-email@example.com

# Authentication secrets (if needed in future)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-key-here

# External API keys (if needed in future)
# OPENAI_API_KEY=your-api-key-here

# Add your environment variables here as the project grows
