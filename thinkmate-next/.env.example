# Environment Variables for ThinkMate Next.js App
# Copy this file to .env.local for local development
# For production, set these in Railway dashboard

# Public API URL (if needed in future)
# NEXT_PUBLIC_API_URL=https://api.thinkmate.com

# Database URL (if needed in future)
# DATABASE_URL=postgresql://user:password@host:port/database

# Authentication secrets (if needed in future)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-key-here

# External API keys (if needed in future)
# OPENAI_API_KEY=your-api-key-here

# Add your environment variables here as the project grows
